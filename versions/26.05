<div class="detail-backdrop" id="detailBackdrop"></div>

<div
  class="detail-modal"
  id="detailModal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="detailTitle"
  aria-hidden="true"
>
  <div class="detail-card" id="detailCard">
    <button class="detail-close" id="detailClose" type="button" aria-label="关闭详情">
      <svg viewBox="0 0 36 36" fill="currentColor" aria-hidden="true">
        <path d="m20.1211 18 3.4395-3.4395c.5859-.5854.5859-1.5356 0-2.1211-.5859-.5859-1.5352-.5859-2.1211 0l-3.4395 3.4395-3.4395-3.4395c-.5859-.5859-1.5352-.5859-2.1211 0-.5859.5854-.5859 1.5356 0 2.1211l3.4395 3.4395-3.4395 3.4395c-.5859.5854-.5859 1.5356 0 2.1211.293.293.6768.4395 1.0605.4395s.7676-.1465 1.0605-.4395l3.4395-3.4395 3.4395 3.4395c.293.293.6768.4395 1.0605.4395s.7676-.1465 1.0605-.4395c.5859-.5854.5859-1.5356 0-2.1211l-3.4395-3.4395z"/>
      </svg>
    </button>

    <div class="detail-icon" id="detailIcon" aria-hidden="true"></div>
    <h3 class="detail-title" id="detailTitle"></h3>
    <p class="detail-desc" id="detailDesc"></p>
    <span class="detail-url" id="detailUrl"></span>

    <a class="detail-open" id="detailOpen" href="#" target="_blank" rel="noopener">
      打开站点
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 2.5 11 8l-6 5.5"/>
      </svg>
    </a>
  </div>
</div>

<script>
  (function () {
    var revealObserver = null;

    if ('IntersectionObserver' in window) {
      revealObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    }

    function observeReveals(container) {
      var els = container.querySelectorAll('.reveal:not(.visible)');
      if (revealObserver) {
        Array.prototype.forEach.call(els, function (el) { revealObserver.observe(el); });
      } else {
        Array.prototype.forEach.call(els, function (el) { el.classList.add('visible'); });
      }
    }

    /* 站点详情弹层 */
    var prefersReducedMotion =
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var detailBackdrop = document.getElementById('detailBackdrop');
    var detailModal = document.getElementById('detailModal');
    var detailCard = document.getElementById('detailCard');
    var detailClose = document.getElementById('detailClose');
    var detailIcon = document.getElementById('detailIcon');
    var detailTitle = document.getElementById('detailTitle');
    var detailDesc = document.getElementById('detailDesc');
    var detailUrl = document.getElementById('detailUrl');
    var detailOpen = document.getElementById('detailOpen');

    var activeTrigger = null;
    var isClosing = false;

    function openDetail(card) {
      if (!card || !detailModal || !detailCard || isClosing) return;
      if (detailModal.classList.contains('visible')) return;

      var iconSvg = card.querySelector('.card-icon');
      var titleEl = card.querySelector('.card-title');
      var urlEl = card.querySelector('.card-url');
      var href = card.getAttribute('href') || '#';
      var desc = card.getAttribute('data-desc') || '';

      detailIcon.innerHTML = iconSvg ? iconSvg.outerHTML : '';
      detailTitle.textContent = titleEl ? titleEl.textContent : '';
      detailDesc.textContent = desc;
      detailUrl.textContent = urlEl ? urlEl.textContent : '';
      detailOpen.setAttribute('href', href);

      activeTrigger = card;

      document.body.style.overflow = 'hidden';
      detailBackdrop.classList.add('visible');
      detailModal.classList.add('visible');
      detailModal.setAttribute('aria-hidden', 'false');

      if (!prefersReducedMotion) {
        var t = card.getBoundingClientRect();
        var c = detailCard.getBoundingClientRect();

        if (c.width > 0 && c.height > 0 && t.width > 0 && t.height > 0) {
          var dx = (t.left + t.width / 2) - (c.left + c.width / 2);
          var dy = (t.top + t.height / 2) - (c.top + c.height / 2);
          var sx = t.width / c.width;
          var sy = t.height / c.height;

          detailCard.style.transition = 'none';
          detailCard.style.transform =
            'translate(' + dx + 'px, ' + dy + 'px) scale(' + sx + ', ' + sy + ')';
          detailCard.style.opacity = '0';

          void detailCard.offsetWidth;

          detailCard.style.transition =
            'transform 0.52s cubic-bezier(0.2, 0.9, 0.2, 1), opacity 0.3s ease';
          detailCard.style.transform = 'translate(0, 0) scale(1, 1)';
          detailCard.style.opacity = '1';
        }
      } else {
        detailCard.style.opacity = '1';
      }

      window.requestAnimationFrame(function () {
        detailClose.focus({ preventScroll: true });
      });
    }

    function closeDetail() {
      if (!detailModal || !detailCard) return;
      if (!detailModal.classList.contains('visible') || isClosing) return;

      isClosing = true;

      if (!prefersReducedMotion) {
        var t = activeTrigger ? activeTrigger.getBoundingClientRect() : null;
        var c = detailCard.getBoundingClientRect();

        if (t && c.width > 0 && c.height > 0) {
          var dx = (t.left + t.width / 2) - (c.left + c.width / 2);
          var dy = (t.top + t.height / 2) - (c.top + c.height / 2);
          var sx = t.width / c.width;
          var sy = t.height / c.height;

          detailCard.style.transition =
            'transform 0.42s cubic-bezier(0.4, 0, 0.6, 1), opacity 0.3s ease';
          detailCard.style.transform =
            'translate(' + dx + 'px, ' + dy + 'px) scale(' + sx + ', ' + sy + ')';
          detailCard.style.opacity = '0';
        } else {
          detailCard.style.transition = 'opacity 0.2s ease';
          detailCard.style.opacity = '0';
        }
      } else {
        detailCard.style.opacity = '0';
      }

      detailBackdrop.classList.remove('visible');
      detailModal.setAttribute('aria-hidden', 'true');

      window.setTimeout(function () {
        detailModal.classList.remove('visible');
        detailCard.style.transition = '';
        detailCard.style.transform = '';
        detailCard.style.opacity = '';
        document.body.style.overflow = '';
        activeTrigger = null;
        isClosing = false;
      }, prefersReducedMotion ? 0 : 440);
    }

    Array.prototype.forEach.call(document.querySelectorAll('.site-card'), function (card) {
      card.addEventListener('click', function (e) {
        e.preventDefault();
        openDetail(card);
      });
    });

    Array.prototype.forEach.call(document.querySelectorAll('.site-add'), function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        openDetail(btn.closest('.site-card'));
      });

      btn.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          e.stopPropagation();
          openDetail(btn.closest('.site-card'));
        }
      });
    });

    if (detailClose) {
      detailClose.addEventListener('click', closeDetail);
    }

    if (detailBackdrop) {
      detailBackdrop.addEventListener('click', closeDetail);
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && detailModal && detailModal.classList.contains('visible')) {
        closeDetail();
      }
    });

    /* 页脚 Studio logo：内联 SVG */
    var SVG_URL = 'https://cdn.jsdelivr.net/gh/MSQY-H/homepage@main/assets/Studio.svg';
    var logoHost = document.getElementById('footerLogo');

    if (logoHost && window.fetch) {
      fetch(SVG_URL, { mode: 'cors' })
        .then(function (res) {
          if (!res.ok) throw new Error('SVG 请求失败');
          return res.text();
        })
        .then(function (text) {
          var trimmed = text.trim();
          if (trimmed.indexOf('<svg') !== 0) throw new Error('不是 SVG 内容');

          logoHost.innerHTML = trimmed;

          var svg = logoHost.querySelector('svg');
          if (!svg) throw new Error('未找到 svg');

          if (!svg.getAttribute('viewBox')) {
            var w = svg.getAttribute('width');
            var h = svg.getAttribute('height');
            if (w && h) {
              svg.setAttribute('viewBox', '0 0 ' + parseFloat(w) + ' ' + parseFloat(h));
            }
          }

          svg.removeAttribute('width');
          svg.removeAttribute('height');
          svg.setAttribute('role', 'img');
          svg.setAttribute('aria-label', 'Studio');
          svg.setAttribute('focusable', 'false');
        })
        .catch(function () {
          /* 内联失败时保留 img 作为兜底 */
        });
    }

    /* 初始导航：移动端汉堡菜单 */
    var toggle = document.getElementById('navToggle');
    var menu = document.getElementById('navMenu');
    var navBackdrop = document.getElementById('navBackdrop');

    function playToggleAnimation(open) {
      if (!toggle) return;

      var suffix = open ? 'open' : 'close';
      var ids = [
        'nav-anim-line-bottom-' + suffix,
        'nav-anim-line-top-' + suffix
      ];

      ids.forEach(function (id) {
        var el = document.getElementById(id);
        if (el && typeof el.beginElement === 'function') {
          el.beginElement();
        }
      });
    }

    function closeMenu() {
      if (!menu || !toggle) return;
      var wasOpen = menu.classList.contains('open');

      menu.classList.remove('open');
      toggle.classList.remove('active');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', '打开菜单');
      document.body.style.overflow = '';

      if (navBackdrop) navBackdrop.classList.remove('visible');

      if (wasOpen) playToggleAnimation(false);
    }

    if (toggle && menu) {
      toggle.addEventListener('click', function (e) {
        e.stopPropagation();

        var isOpen = menu.classList.toggle('open');
        toggle.classList.toggle('active', isOpen);
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        toggle.setAttribute('aria-label', isOpen ? '关闭菜单' : '打开菜单');

        document.body.style.overflow = isOpen ? 'hidden' : '';

        if (navBackdrop) {
          navBackdrop.classList.toggle('visible', isOpen);
        }

        playToggleAnimation(isOpen);
      });

      Array.prototype.forEach.call(menu.querySelectorAll('a'), function (link) {
        link.addEventListener('click', closeMenu);
      });

      if (navBackdrop) {
        navBackdrop.addEventListener('click', closeMenu);
      }

      document.addEventListener('click', function (e) {
        if (!menu.classList.contains('open')) return;
        if (menu.contains(e.target) || toggle.contains(e.target)) return;
        closeMenu();
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeMenu();
      });

      window.addEventListener('resize', function () {
        if (window.innerWidth > 600) closeMenu();
      });
    }

    /* localnav */
    var localnav = document.getElementById('localnav');
    var localnavToggle = document.getElementById('localnavToggle');
    var localnavMenu = document.getElementById('localnavMenu');
    var localnavBackdrop = document.getElementById('localnavBackdrop');
    var localnavLinks = localnavMenu
      ? localnavMenu.querySelectorAll('a[data-section]')
      : [];
    var ticking = false;

    function setLocalnavExpanded(expanded, focusTarget) {
      if (!localnav || !localnavToggle) return;

      localnav.classList.toggle('expanded', expanded);
      localnavToggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      localnavToggle.setAttribute('aria-label', expanded ? '收起本页目录' : '展开本页目录');

      if (localnavBackdrop) {
        localnavBackdrop.classList.toggle('visible', expanded);
      }

      if (expanded) {
        var first = localnavMenu.querySelector('a');
        if (first) {
          window.requestAnimationFrame(function () {
            first.focus({ preventScroll: true });
          });
        }
      } else if (focusTarget === 'toggle') {
        localnavToggle.focus({ preventScroll: true });
      }
    }

    var sectionIds = ['projects', 'sites', 'articles', 'contact'];
    var sectionEls = sectionIds
      .map(function (id) { return document.getElementById(id); })
      .filter(Boolean);

    function updateCurrentSection() {
      if (!localnavLinks.length) return;

      var trigger = 68;
      var current = null;

      if (sectionEls.length) {
        var firstRect = sectionEls[0].getBoundingClientRect();
        if (firstRect.top > trigger) {
          current = sectionEls[0].id;
        }
      }

      if (!current) {
        for (var i = 0; i < sectionEls.length; i++) {
          var rect = sectionEls[i].getBoundingClientRect();
          if (rect.top <= trigger && rect.bottom > trigger) {
            current = sectionEls[i].id;
            break;
          }
        }
      }

      if (!current && sectionEls.length) {
        var last = sectionEls[sectionEls.length - 1];
        if (last.getBoundingClientRect().bottom <= trigger) {
          current = last.id;
        }
      }

      Array.prototype.forEach.call(localnavLinks, function (a) {
        a.classList.toggle(
          'current',
          a.getAttribute('data-section') === current
        );
      });
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(function () {
          if (window.scrollY > 80) {
            localnav.classList.add('visible');
          } else {
            localnav.classList.remove('visible');
            setLocalnavExpanded(false);
          }
          updateCurrentSection();
          ticking = false;
        });
        ticking = true;
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    if (localnavToggle && localnavMenu) {
      localnavToggle.addEventListener('click', function (e) {
        e.stopPropagation();
        setLocalnavExpanded(!localnav.classList.contains('expanded'));
      });

      Array.prototype.forEach.call(localnavMenu.querySelectorAll('a'), function (link) {
        link.addEventListener('click', function () {
          setLocalnavExpanded(false);
        });
      });

      if (localnavBackdrop) {
        localnavBackdrop.addEventListener('click', function () {
          setLocalnavExpanded(false);
        });
      }

      document.addEventListener('click', function (e) {
        if (!localnav.classList.contains('expanded')) return;
        if (localnav.contains(e.target)) return;
        setLocalnavExpanded(false);
      });

      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        if (!localnav.classList.contains('expanded')) return;
        setLocalnavExpanded(false, 'toggle');
      });
    }

    /* 头像兜底 */
    var avatar = document.querySelector('.avatar');
    if (avatar) {
      avatar.addEventListener('error', function () {
        var initial = document.createElement('div');
        initial.className = 'avatar';
        initial.style.display = 'flex';
        initial.style.alignItems = 'center';
        initial.style.justifyContent = 'center';
        initial.style.fontSize = '42px';
        initial.style.fontWeight = '600';
        initial.style.color = 'var(--text-secondary)';
        initial.textContent = 'M';
        avatar.parentNode.replaceChild(initial, avatar);
      });
    }

    /* 横向滚动 */
    function initScroller(scrollerId, wrapId, prevId, nextId) {
      var scroller = document.getElementById(scrollerId);
      var wrap = document.getElementById(wrapId);
      var prevBtn = document.getElementById(prevId);
      var nextBtn = document.getElementById(nextId);

      if (!scroller || !prevBtn || !nextBtn) return;

      function updatePaddles() {
        var maxScroll = scroller.scrollWidth - scroller.clientWidth;
        var atStart = scroller.scrollLeft <= 2;
        var atEnd = scroller.scrollLeft >= maxScroll - 2;

        prevBtn.disabled = atStart;
        nextBtn.disabled = atEnd;

        if (wrap) {
          wrap.classList.toggle('at-start', atStart);
          wrap.classList.toggle('at-end', atEnd);
        }
      }

      function scrollByStep(dir) {
        var card = scroller.querySelector('.site-card');
        var gap = parseFloat(getComputedStyle(scroller).columnGap) || 16;
        var step = card ? card.getBoundingClientRect().width + gap : 300;
        scroller.scrollBy({ left: dir * step, behavior: 'smooth' });
      }

      prevBtn.addEventListener('click', function () { scrollByStep(-1); });
      nextBtn.addEventListener('click', function () { scrollByStep(1); });

      scroller.addEventListener('scroll', updatePaddles, { passive: true });
      window.addEventListener('resize', updatePaddles);

      if ('ResizeObserver' in window) {
        new ResizeObserver(updatePaddles).observe(scroller);
      }
      window.addEventListener('load', updatePaddles);

      updatePaddles();
    }

    initScroller('siteScroller', 'siteScrollerWrap', 'sitePrev', 'siteNext');
    initScroller('contactScroller', 'contactScrollerWrap', 'contactPrev', 'contactNext');

    /* 文章 RSS */
    function timeAgo(dateString) {
      var now = new Date();
      var date = new Date(dateString);
      var diff = Math.floor((now - date) / 1000);

      if (isNaN(diff) || diff < 0) return '刚刚';
      if (diff < 60) return '刚刚';
      if (diff < 3600) return Math.floor(diff / 60) + ' 分钟前';
      if (diff < 86400) return Math.floor(diff / 3600) + ' 小时前';
      if (diff < 86400 * 30) return Math.floor(diff / 86400) + ' 天前';

      var y = date.getFullYear();
      var m = String(date.getMonth() + 1).padStart(2, '0');
      return y + '.' + m;
    }

    function escapeHtml(str) {
      var div = document.createElement('div');
      div.appendChild(document.createTextNode(str));
      return div.innerHTML;
    }

    var RSS_URL = 'https://www.msqy.cc.cd/rss.xml';
    var RSS2JSON_API = 'https://api.rss2json.com/v1/api.json?rss_url=' +
      encodeURIComponent(RSS_URL) + '&count=5';
    var articleList = document.getElementById('articleList');

    function renderArticles(items) {
      if (!articleList) return;

      if (!items.length) {
        articleList.innerHTML =
          '<div class="news-empty">RSS 源里还没有文章。' +
          '<br><a href="' + RSS_URL + '" target="_blank" rel="noopener">直接打开 RSS 源 →</a></div>';
        return;
      }

      var html = items.slice(0, 5).map(function (item, i) {
        var title = item.title || '无标题';
        var link = item.link || '#';
        var pubDate = item.pubDate || '';
        var categories = item.categories || [];
        var category = categories.length ? categories[0] : '文章';
        var delay = (i * 0.05).toFixed(2) + 's';

        return (
          '<a class="news-row reveal" style="--d: ' + delay + '" href="' + escapeHtml(link) + '" target="_blank" rel="noopener">' +
            '<span class="news-category">' + escapeHtml(category) + '</span>' +
            '<h3 class="news-title">' + escapeHtml(title) + '</h3>' +
            '<span class="news-date">' + timeAgo(pubDate) + '</span>' +
          '</a>'
        );
      }).join('');

      articleList.innerHTML = html;
      observeReveals(articleList);
    }

    function loadArticles() {
      if (!articleList) return;

      var cacheKey = 'rss_articles_msqy';
      try {
        var cached = localStorage.getItem(cacheKey);
        if (cached) {
          var parsed = JSON.parse(cached);
          if (Date.now() - parsed.time < 15 * 60 * 1000) {
            renderArticles(parsed.data);
            return;
          }
        }
      } catch (e) { /* 忽略 */ }

      fetch(RSS2JSON_API)
        .then(function (res) {
          if (!res.ok) throw new Error('rss2json 请求失败（' + res.status + '）');
          return res.json();
        })
        .then(function (data) {
          if (data.status !== 'ok' || !data.items) throw new Error('RSS 解析失败');
          renderArticles(data.items);
          try {
            localStorage.setItem(cacheKey, JSON.stringify({ time: Date.now(), data: data.items }));
          } catch (e) { /* 忽略 */ }
        })
        .catch(function () {
          if (!articleList) return;
          articleList.innerHTML =
            '<div class="news-empty">文章加载失败。' +
            '<br><a href="' + RSS_URL + '" target="_blank" rel="noopener">直接打开 RSS 源 →</a></div>';
        });
    }

    observeReveals(document);
    loadArticles();
  })();
</script>

</body>
</html>
